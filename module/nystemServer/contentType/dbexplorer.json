{
  "storage": "memory",
  "_features": ["date", "access"],
  "name": "dbexplorer",
  "machinename": "dbexplorer",
  "views": [
    {
      "format": "list",
      "name": "list",
      "item": [
        {
          "type": "bootstrap",
          "format": "panel",
          "stateStore": "disabled",
          "header": [
            {
              "type": "bootstrap",
              "format": "panelToggle",
              "icon": true,
              "className": ["flex", "items-center"],
              "item": [{ "type": "viewText", "text": "Database explorer" }]
            }
          ],
          "item": [
            {
              "type": "database",
              "format": "search",
              "count": 20,
              "sortby": [{ "id": "_chdate", "type": "date" }],
              "reversesortby": true
            },
            {
              "type": "devtools",
              "format": "selectContenttype",
              "limit": 1,
              "inline": true,
              "render": "button",
              "nolabel": true,
              "className": ["mb-3"],
              "classNameInput": ["flex", "flex-wrap", "gap-1.5"],
              "classNameItem": ["!text-xs", "!px-2", "!py-1"],
              "size": "xs"
            },
            {
              "type": "devtools",
              "format": "urlPartFilter",
              "text": "Filter",
              "includeId": true,
              "className": ["flex", "items-center", "!my-0", "mb-3", "gap-2"],
              "classNameLabel": ["!min-w-0", "!w-auto", "!text-left", "!mt-0", "!mr-0", "text-sm", "shrink-0"],
              "classNameInput": ["flex", "flex-wrap", "gap-1.5"],
              "classNameItem": ["!text-xs", "!px-2", "!py-1"]
            },
            {
              "type": "style",
              "item": [
                {
                  "type": "viewList",
                  "format": "search",
                  "className": ["flex-1", "min-w-40"],
                  "includeId": true,
                  "nolabel": true,
                  "placeholder": "Search records",
                  "classNameInput": [
                    "w-full",
                    "rounded",
                    "!border-gray-600",
                    "!bg-gray-900",
                    "!text-white",
                    "!px-3",
                    "!py-2",
                    "text-sm",
                    "focus:!border-blue-500"
                  ]
                },
                { "type": "viewText", "text": "Count", "className": ["text-sm", "text-gray-400"] },
                {
                  "type": "viewList",
                  "format": "listStat",
                  "show": ["searchTotal", "total"],
                  "text": "",
                  "className": ["text-sm", "tabular-nums"]
                }
              ],
              "className": ["flex", "flex-wrap", "items-center", "gap-3", "my-3"]
            },
            {
              "type": "style",
              "item": [
                {
                  "id": "_crdate",
                  "type": "date",
                  "format": "sortBy",
                  "text": "Created",
                  "className": ["w-40", "shrink-0"]
                },
                {
                  "id": "_chdate",
                  "type": "date",
                  "format": "sortBy",
                  "text": "Changed",
                  "className": ["w-40", "shrink-0"]
                },
                { "type": "text", "id": "name", "format": "sortBy", "className": ["flex-1", "min-w-0"] },
                {
                  "id": "_id",
                  "type": "text",
                  "format": "sortBy",
                  "text": "Id",
                  "className": ["w-8", "shrink-0", "text-center"]
                }
              ],
              "className": [
                "flex",
                "items-center",
                "py-2",
                "mb-2",
                "border-b",
                "border-gray-700",
                "text-xs",
                "text-gray-400",
                "pl-9",
                "pr-3"
              ]
            },
            {
              "type": "viewList",
              "format": "infinite",
              "item": [
                {
                  "type": "viewList",
                  "rowClassName": [""],
                  "item": [
                    {
                      "type": "bootstrap",
                      "format": "panel",
                      "stateStore": "byUrl",
                      "header": [
                        {
                          "type": "bootstrap",
                          "format": "panelToggle",
                          "iconClassName": ["w-4", "h-4", "mr-2", "shrink-0"],
                          "icon": true,
                          "item": [
                            {
                              "id": "_crdate",
                              "type": "date",
                              "className": ["w-40", "shrink-0", "truncate"],
                              "format": "view"
                            },
                            {
                              "id": "_chdate",
                              "type": "date",
                              "className": ["w-40", "shrink-0", "truncate"],
                              "format": "view"
                            },
                            {
                              "type": "style",
                              "className": ["flex-1", "min-w-0", "truncate"],
                              "item": [
                                {
                                  "type": "conditional",
                                  "condition": [["name", "true"]],
                                  "item": [{ "type": "text", "id": "name", "className": ["truncate"] }]
                                },
                                {
                                  "type": "conditional",
                                  "condition": [["name", "false"]],
                                  "item": [
                                    {
                                      "type": "conditional",
                                      "condition": [["title", "true"]],
                                      "item": [{ "type": "text", "id": "title", "className": ["truncate"] }]
                                    },
                                    {
                                      "type": "conditional",
                                      "condition": [["title", "false"]],
                                      "item": [
                                        {
                                          "type": "text",
                                          "id": "_id",
                                          "className": ["truncate", "text-xs", "font-mono"]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "copyToClipBoard",
                              "text": "Copy ID",
                              "field": "_id",
                              "btnSize": "xs",
                              "gotoOnClick": false,
                              "btnType": "secondary",
                              "className": ["inline-flex", "items-center", "justify-center", "h-8", "w-8", "shrink-0"],
                              "icon": "copy"
                            }
                          ],
                          "className": ["flex", "items-center", "py-1", "min-w-0"]
                        }
                      ],
                      "item": [
                        {
                          "type": "style",
                          "item": [
                            {
                              "type": "style",
                              "item": [
                                {
                                  "type": "bootstrap",
                                  "format": "panel",
                                  "typeClass": "compact",
                                  "stateStore": "disabled",
                                  "expanded": false,
                                  "className": ["relative", "!border-0", "!bg-transparent", "[&>*]:!p-0"],
                                  "header": [
                                    {
                                      "type": "bootstrap",
                                      "format": "panelToggle",
                                      "className": [
                                        "flex",
                                        "items-center",
                                        "justify-center",
                                        "rounded",
                                        "bg-gray-700",
                                        "hover:bg-gray-600",
                                        "h-8",
                                        "w-8",
                                        "text-white",
                                        "cursor-pointer"
                                      ],
                                      "item": [
                                        {
                                          "type": "icon",
                                          "icon": "key",
                                          "title": "Set password",
                                          "className": ["h-4", "w-4"]
                                        }
                                      ]
                                    }
                                  ],
                                  "item": [
                                    {
                                      "type": "style",
                                      "className": [
                                        "absolute",
                                        "right-0",
                                        "top-full",
                                        "z-30",
                                        "mt-2",
                                        "rounded-lg",
                                        "border",
                                        "border-gray-600",
                                        "bg-gray-900",
                                        "p-3",
                                        "shadow-lg",
                                        "w-96",
                                        "max-w-[calc(100vw-3rem)]",
                                        "flex",
                                        "items-center",
                                        "gap-2"
                                      ],
                                      "item": [
                                        {
                                          "type": "password",
                                          "format": "input",
                                          "id": "password",
                                          "text": "Password",
                                          "nolabel": true,
                                          "mandatory": false,
                                          "classNameInput": [
                                            "w-full",
                                            "rounded",
                                            "border",
                                            "border-gray-600",
                                            "bg-gray-800",
                                            "px-3",
                                            "py-2",
                                            "text-white"
                                          ],
                                          "className": ["flex-1", "min-w-0"],
                                          "focus": true
                                        },
                                        {
                                          "type": "viewButton",
                                          "format": "eventEmitter",
                                          "eventType": "view",
                                          "event": "submit",
                                          "text": "Save",
                                          "noValidation": true,
                                          "btnType": "primary",
                                          "size": "sm",
                                          "className": ["shrink-0", "whitespace-nowrap"]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "copyToClipBoard",
                                  "text": "Copy JSON",
                                  "btnSize": "sm",
                                  "btnType": "default",
                                  "className": [
                                    "inline-flex",
                                    "items-center",
                                    "justify-center",
                                    "h-8",
                                    "w-8",
                                    "shrink-0"
                                  ],
                                  "icon": "copy"
                                },
                                {
                                  "type": "viewButton",
                                  "format": "input",
                                  "text": "Save",
                                  "btnType": "primary",
                                  "className": ["flex", "flex-wrap", "gap-2"],
                                  "size": "sm"
                                }
                              ],
                              "className": [
                                "flex",
                                "flex-wrap",
                                "items-center",
                                "justify-end",
                                "gap-2",
                                "p-2",
                                "bg-gray-900",
                                "border-b",
                                "border-gray-700"
                              ]
                            }
                          ],
                          "className": []
                        },
                        {
                          "type": "viewText",
                          "text": "content",
                          "format": "codemirror",
                          "className": [
                            "h-96",
                            "w-full",
                            "relative",
                            "[&_.CodeMirror]:text-sm",
                            "[&_.CodeMirror]:leading-6",
                            "[&_.CodeMirror]:h-full"
                          ]
                        }
                      ],
                      "className": ["w-full", "my-3"],
                      "typeClass": "defaultWithoutPadding"
                    }
                  ],
                  "headerFields": [],
                  "className": [""],
                  "header": [{ "type": "viewText", "text": "Database explorer" }],
                  "emptyFields": [
                    {
                      "type": "viewText",
                      "text": "No data found",
                      "renderAs": "h3",
                      "className": ["ml-6", "font-bold"]
                    }
                  ]
                }
              ],
              "slotLimit": 5,
              "clearHeightOnUpdate": true
            }
          ],
          "expanded": true,
          "className": ["mx-3", "mt-3", "devtools-explorer-panel"]
        }
      ]
    }
  ],
  "item": [
    { "type": "text", "text": "Name", "id": "name" },
    { "type": "text", "text": "Title", "id": "title" }
  ],
  "noClientCache": true
}
