                  "className": ["flex", "items-center", "p-1", "pt-0"]
                },
                {
                  "category": "view",
                  "type": "viewInView",
                  "contentType": "serverStatus",
                  "view": "status",
                  "viewId": "{_id}",
                  "format": "empty"
                }
              ],
              "match": "localhost"
