{
  "name": "server",
  "_roles": { "save": [] },
  "default": { "length": "50", "text_mandatory": "Field is mandatory", "mandatory": true, "type": "text" },
  "item": [
    { "id": "name", "text": "Name", "type": "text" },
    { "id": "host", "text": "Host", "type": "multilinetext" },
    { "id": "path", "text": "Path", "type": "text", "length": "100" },
    { "type": "int", "id": "port", "text": "Port" },
    { "id": "showinoverview", "text": "In overview", "type": "boolean", "mandatory": false }
  ],
  "machinename": "server",
  "storage": "data",
  "views": [
    {
      "name": "codex",
      "format": "view",
      "item": [
        {
          "category": "view",
          "type": "style",
          "item": [
            {
              "category": "view",
              "type": "style",
              "item": [
                {
                  "category": "contentTypeField",
                  "type": "text",
                  "id": "name",
                  "renderAs": "div",
                  "className": ["flex-grow"],
                  "format": "view"
                },
                {
                  "category": "view",
                  "type": "viewInView",
                  "contentType": "serverStatus",
                  "view": "controlnohide",
                  "className": [""],
                  "format": "empty",
                  "viewId": "{_id}"
                }
              ],
              "className": ["flex", "items-center"]
            },
            {
              "category": "view",
              "type": "viewInView",
              "contentType": "serverStatus",
              "view": "status",
              "viewId": "{_id}",
              "format": "empty"
            }
          ],
          "className": ["p-3", "max-w-4xl"]
        }
      ]
    },
    {
      "name": "devtools",
      "item": [
        {
          "category": "view",
          "type": "extension",
          "item": [
            {
              "type": "style",
              "className": ["devtools-layout", "flex", "flex-col", "h-dvh", "overflow-hidden"],
              "item": [
                {
                  "category": "view",
                  "type": "extension",
                  "format": "tab",
                  "item": [
                    {
                      "category": "view",
                      "type": "extension",
                      "item": [
                        {
                          "type": "viewLink",
                          "format": "dynamicFields",
                          "href": "http://nystem.localhost/server/list",
                          "item": [{ "type": "viewText", "text": "Open server manager — no server matches this host" }],
                          "className": ["block", "p-3", "text-blue-400"]
                        }
                      ],
                      "format": "search",
                      "field": "host",
                      "extract": "(\\/\\/)([^\\/]+)"
                    },
                    {
                      "type": "conditional",
                      "condition": [["_id", "true"]],
                      "item": [
                        {
                          "type": "style",
                          "className": ["devtools-server", "mx-3", "mt-3"],
                          "item": [
                            {
                              "category": "view",
                              "type": "bootstrap",
                              "format": "panel",
                              "header": [
                                {
                                  "category": "view",
                                  "type": "style",
                                  "item": [
                                    {
                                      "category": "view",
                                      "type": "bootstrap",
                                      "format": "panelToggle",
                                      "item": [
                                        {
                                          "category": "contentTypeField",
                                          "type": "text",
                                          "id": "name",
                                          "renderAs": "div",
                                          "className": [""],
                                          "format": "view"
                                        }
                                      ],
                                      "icon": true,
                                      "className": ["flex", "items-center", "content-center", "py-1", "", "flex-grow"]
                                    },
                                    {
                                      "type": "viewInView",
                                      "contentType": "serverStatus",
                                      "view": "controlnohide",
                                      "viewId": "{_id}",
                                      "format": "empty"
                                    }
                                  ],
                                  "format": "onOverHandle",
                                  "className": ["flex", "items-center"]
                                }
                              ],
                              "item": [
                                {
                                  "category": "view",
                                  "type": "viewInView",
                                  "contentType": "serverStatus",
                                  "view": "status",
                                  "viewId": "{_id}",
                                  "format": "empty"
                                }
                              ],
                              "typeClass": "defaultWithoutPadding",
                              "stateStore": "disabled",
                              "expanded": true
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "match": "localhost"
                },
                { "type": "devtools" },
                {
                  "type": "viewInView",
                  "contentType": "dbexplorer",
                  "view": "list",
                  "className": ["devtools-explorer", "flex", "flex-col", "flex-1", "min-h-0"]
                },
                {
                  "type": "viewInView",
                  "contentType": "server",
                  "view": "devtoolsettings",
                  "className": ["devtools-settings", "shrink-0", "min-h-0"]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "devtoolsettings",
      "item": [
        {
          "type": "bootstrap",
          "format": "panel",
          "stateStore": "disabled",
          "header": [
            {
              "type": "bootstrap",
              "format": "panelToggle",
              "icon": true,
              "className": ["flex", "items-center"],
              "item": [{ "type": "viewText", "text": "Settings", "className": ["py-2"] }]
            }
          ],
          "item": [
            { "type": "devtools", "format": "settings" },
            { "type": "viewText", "format": "codemirror", "className": ["h-96"] }
          ],
          "className": ["mx-3", "my-3", "shadow", "devtools-settings-panel"],
          "typeClass": "defaultWithoutPadding"
        }
      ]
    },
    {
      "name": "extension",
