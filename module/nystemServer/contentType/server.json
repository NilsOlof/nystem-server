        {
          "category": "view",
          "type": "extension",
          "item": [
            {
              "category": "view",
              "type": "extension",
              "format": "tab",
              "item": [
                {
                  "category": "view",
                  "type": "extension",
                  "format": "search",
                  "field": "host",
